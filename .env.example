# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Настройки AI ---
# none | gemini
AI_PROVIDER=gemini

# Ключ для Google Gemini: https://aistudio.google.com/apikey
AI_API_KEY=your_gemini_api_key_here

# Актуальная быстрая модель на момент написания. Список моделей:
# https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-3.5-flash-lite

# --- Mini App ---
# Публичный https-адрес мини-приложения (сервер: server/main.py).
# Локально получить его можно через ngrok: `ngrok http 8000`,
# скопировать выданный https://....ngrok-free.app сюда.
WEBAPP_URL=
